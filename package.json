{
  "name": "cifrante",
  "version": "0.4.0",
  "description": "Lightweight cryptography, native when possible and portable by design",
  "license": "MIT",
  "author": "sanyok12345",
  "homepage": "https://github.com/sanyok12345/cifrante",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanyok12345/cifrante.git"
  },
  "bugs": {
    "url": "https://github.com/sanyok12345/cifrante/issues"
  },
  "keywords": [
    "cryptography",
    "crypto",
    "hash",
    "aes",
    "rsa",
    "hmac",
    "pbkdf2",
    "hkdf"
  ],
  "type": "module",
  "main": "./dist/cifrante.node.cjs",
  "module": "./dist/cifrante.mjs",
  "types": "./dist/cifrante.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/cifrante.d.mts",
        "node": "./dist/cifrante.node.mjs",
        "default": "./dist/cifrante.mjs"
      },
      "require": {
        "types": "./dist/cifrante.d.cts",
        "node": "./dist/cifrante.node.cjs",
        "default": "./dist/cifrante.cjs"
      },
      "default": "./dist/cifrante.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "make -C wasm && make -C native && tsdown",
    "prepublishOnly": "npm run build && make -C native publish"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@cifrante/darwin-arm64": "0.3.1",
    "@cifrante/darwin-x64": "0.3.1",
    "@cifrante/linux-arm64-gnu": "0.3.1",
    "@cifrante/linux-arm64-musl": "0.3.1",
    "@cifrante/linux-x64-gnu": "0.3.1",
    "@cifrante/linux-x64-musl": "0.3.1",
    "@cifrante/win32-arm64": "0.3.1",
    "@cifrante/win32-x64": "0.3.1"
  }
}
